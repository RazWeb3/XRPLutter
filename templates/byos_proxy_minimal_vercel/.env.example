# -------------------------------------------------------
# 目的・役割: BYOS最小プロキシの環境変数サンプル（Vercel向け）。KV有無切り替え対応。
# 作成日: 2025/11/10
# -------------------------------------------------------

# JWTの秘密鍵（短命トークン検証用）
JWT_SECRET=change-me-please
JWT_AUD=
JWT_ISS=
JWT_MAX_TTL_SECONDS=300

# CORS許可オリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:53210

# レート制限（ウィンドウ秒/最大リクエスト数）
RL_WINDOW_SECONDS=10
RL_MAX_REQUESTS=20

# Xaman API認証情報（必要時に設定）
XAMAN_API_KEY=
XAMAN_API_SECRET=

# Xaman プラットフォームAPIベースURL
# 例: https://xaman.app/api/v1/platform
XAMAN_API_BASE=https://xaman.app/api/v1/platform

# ストレージバックエンド: memory | upstash
STORAGE_BACKEND=memory

# セッションのTTL（秒）
TTL_SECONDS=600

# KV（Upstash Redis REST）利用時に設定
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=